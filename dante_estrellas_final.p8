pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- dante y las estrellas
-- version 1.4: musica continua y dedicatoria

function _init()
 cambiar_planeta(1)
 -- iniciar la musica solo una vez
 music(0,500)
end

function cambiar_planeta(n)
 planeta=n
 offset=(n-1)*16
 estrellas={}
 plataformas={}
 temporales={}
 recogidas=0
 rosa=nil
 victoria=false
 listo=false
 final_t=0
 camila_x=136
 corazon_sonido=false

 dante={
  x=8,y=80,vy=0,
  en_suelo=false,
  andando=false,
  direccion=1,
  sobre=nil
 }
 if planeta==1 then
  dante.x=60
 end

 -- objetos de este planeta
 for cy=0,15 do
  for cx=0,15 do
   local id=mget(offset+cx,cy)
   local px=cx*8
   local py=cy*8

   if id==17 then
    add(estrellas,{
     x=px,y=py,tomada=false
    })
   elseif id==20 then
    rosa={x=px,y=py}
   elseif planeta==2 and fget(id,1) then
    add(plataformas,{
     x=px,y=py,origen=px,
     sprid=id,vel=0.4,dx=0,
     tipo=1
    })
   elseif planeta==3 and fget(id,2) then
    add(temporales,{
     x=px,y=py,sprid=id,
     estado=0,t=0,tipo=2
    })
   end
  end
 end

end

-- terrenos fijos: bandera 0
function solido(x,y)
 if x<0 or x>=128
 or y<0 or y>=128 then
  return false
 end
 local tx=offset+flr(x/8)
 local ty=flr(y/8)
 local id=mget(tx,ty)
 return fget(id,0)
  and not fget(id,1)
  and not fget(id,2)
end

function toca_muro(x,y)
 return solido(x,y)
  or solido(x+7,y)
  or solido(x,y+7)
  or solido(x+7,y+7)
end

function mover_x(dx)
 while abs(dx)>0 do
  local paso=sgn(dx)*min(abs(dx),1)
  local nx=dante.x+paso
  if nx<0 or nx>120
  or toca_muro(nx,dante.y) then
   break
  end
  dante.x=nx
  dx-=paso
 end
end

-- aterrizar sobre plataformas especiales
function caer_en(lista,pies,nuevos_pies)
 for p in all(lista) do
  if (p.tipo==1 or p.estado<2)
  and pies<=p.y
  and nuevos_pies>=p.y
  and dante.x+8>p.x
  and dante.x<p.x+8 then
   dante.y=p.y-8
   dante.vy=0
   dante.en_suelo=true
   dante.sobre=p

   -- comenzar cuenta regresiva
   if p.tipo==2 and p.estado==0 then
    p.estado=1
    p.t=48
   end
   return true
  end
 end
 return false
end

function mover_y(dy)
 dante.en_suelo=false
 dante.sobre=nil

 while abs(dy)>0 do
  local paso=sgn(dy)*min(abs(dy),1)
  local ny=dante.y+paso

  -- mantener el salto superior original
  if ny>120 or toca_muro(dante.x,ny) then
   if paso>0 then
    dante.en_suelo=true
   end
   dante.vy=0
   break
  end

  if paso>0 then
   local pies=dante.y+8
   local nuevos_pies=ny+8
   if caer_en(plataformas,pies,nuevos_pies)
   or caer_en(temporales,pies,nuevos_pies) then
    return
   end
  end

  dante.y=ny
  dy-=paso
 end
end

-- cometas del planeta 2
function mover_plataformas()
 for p in all(plataformas) do
  local antes=p.x
  local nx=p.x+p.vel
  if nx>p.origen+8 then
   nx=p.origen+8
   p.vel=-abs(p.vel)
  elseif nx<p.origen-8 then
   nx=p.origen-8
   p.vel=abs(p.vel)
  end
  p.x=nx
  p.dx=p.x-antes
 end
end

-- cristales del planeta 3
function actualizar_temporales()
 for p in all(temporales) do
  if p.estado==1 then
   p.t-=1
   if p.t<=0 then
    p.estado=2
    p.t=90
    if dante.sobre==p then
     dante.en_suelo=false
     dante.sobre=nil
    end
   end
  elseif p.estado==2 then
   p.t-=1
   if p.t<=0 then
    p.estado=0
    p.t=0
   end
  end
 end
end

function _update60()
 -- continuar entre escenas
 if victoria then
  if planeta==3 then
   -- primero se lee el mensaje
   final_t+=1

   -- camila entra luego de leer
   -- el mensaje (2.5 segundos)
   if final_t>150 then
    camila_x=max(72,camila_x-0.5)
    if camila_x<=72 and not corazon_sonido then
     sfx(33,3)
     corazon_sonido=true
    end
   end

   -- volver a jugar tras el abrazo
   if final_t>390 and btnp(4) then
    cambiar_planeta(1)
   end
  else
   -- continuar entre planetas
   if not btn(4) then
    listo=true
   end
   if listo and btnp(4) then
    cambiar_planeta(planeta+1)
   end
  end
  return
 end

 local soporte=dante.sobre
 mover_plataformas()
 actualizar_temporales()

 -- viajar encima de los cometas
 if soporte and soporte.tipo==1
 and dante.en_suelo then
  mover_x(soporte.dx)
 end

 local dx=0
 dante.andando=false
 if btn(0) then
  dx=-1
  dante.direccion=-1
  dante.andando=true
 end
 if btn(1) then
  dx=1
  dante.direccion=1
  dante.andando=true
 end

 if btnp(4) and dante.en_suelo then
  dante.vy=-3.5
  dante.en_suelo=false
  dante.sobre=nil
 end

 dante.vy=min(dante.vy+0.22,3)
 mover_x(dx)
 mover_y(dante.vy)

 -- recoger estrellas
 for e in all(estrellas) do
  if not e.tomada
  and dante.x<e.x+8
  and dante.x+8>e.x
  and dante.y<e.y+8
  and dante.y+8>e.y then
   e.tomada=true
   recogidas+=1
   sfx(32,3)
  end
 end

 -- rescatar la rosa
 if rosa and #estrellas>0
 and recogidas==#estrellas
 and dante.x<rosa.x+8
 and dante.x+8>rosa.x
 and dante.y<rosa.y+8
 and dante.y+8>rosa.y then
  victoria=true
  listo=false
  -- la musica continua durante el final
 end
end

function dibujar_dante()
 local frame=1
 if not dante.en_suelo then
  if dante.direccion==1 then
   if dante.vy<0 then
    frame=7
   else
    frame=8
   end
  else
   if dante.vy<0 then
    frame=9
   else
    frame=10
   end
  end
 elseif dante.andando then
  local paso=flr(time()*6)%2
  if dante.direccion==1 then
   frame=3+paso
  else
   frame=5+paso
  end
 else
  frame=1+flr(time()*1.5)%2
 end
 spr(frame,dante.x,dante.y)
end

function dibujar_cuento()
 cls(13)
 pset(14,15,10)
 pset(101,20,7)
 pset(112,48,10)
 pset(20,77,7)
 pset(91,103,10)

 if planeta==1 then
  print("las estrellas",38,24,7)
  print("brillaban para todos,",20,35,7)
  print("pero aquella rosa",30,46,10)
  print("brillaba para el.",30,58,10)
  pset(87,56,10)
  pset(88,55,10)
  print("z para continuar",30,115,7)
 elseif planeta==2 then
  print("dante siguio viajando",20,24,7)
  print("entre los cometas,",28,37,7)
  print("con su rosa muy cerca.",18,54,10)
  print("z para continuar",30,115,7)
 else
  -- dedicatoria final centrada
  print("aquella rosa",40,18,7)
  print("le recordaba el",34,30,7)
  print("hermoso cabello rojito",20,42,10)
  print("de su mama.",42,54,10)

  print("para mami,",44,94,7)
  print("de dante",48,105,10)

  -- dante espera junto a la rosa
  spr(1,48,74)
  spr(20,60,74)

  -- camila viene desde la derecha
  if final_t>150 then
   if camila_x>72 then
    local paso=flr(final_t/8)%2
    spr(13+paso,camila_x,74)
   else
    -- camila se queda junto a dante
    spr(12,72,74)

    -- el corazon aparece al llegar
    -- y flota un pixel suavemente
    spr(29,62,64-flr(final_t/24)%2)
   end
  end

  if final_t>390 then
   print("z para volver a jugar",22,119,6)
  end
 end

 -- las primeras escenas quedan intactas
 if planeta<3 then
  spr(1,54,86)
  spr(20,70,86)
 end
end

function _draw()
 if victoria then
  dibujar_cuento()
  return
 end

 if planeta==1 then
  cls(13)
 elseif planeta==2 then
  cls(2)
  line(12,20,22,14,7)
  pset(28,11,10)
  line(80,24,87,20,10)
  pset(101,36,7)
 else
  cls(2)
  pset(18,16,14)
  pset(91,12,10)
  pset(108,51,7)
 end

 -- pintar solo bloques fijos
 map(offset,0,0,0,16,16,1)

 -- cometas que se desplazan
 for p in all(plataformas) do
  spr(p.sprid,p.x,p.y)
 end

 -- cristales que desaparecen
 for p in all(temporales) do
  if p.estado==0
  or (p.estado==1
  and (p.t>18 or flr(p.t/3)%2==0)) then
   spr(p.sprid,p.x,p.y)
  end
 end

 for e in all(estrellas) do
  if not e.tomada then
   spr(17,e.x,e.y)
  end
 end

 if rosa and #estrellas>0
 and recogidas==#estrellas then
  spr(20,rosa.x,rosa.y)
 end

 dibujar_dante()

 -- hud inferior
 rectfill(0,112,127,127,1)
 line(0,111,127,111,10)
 if #estrellas>0
 and recogidas==#estrellas then
  print("encuentra la rosa!",28,117,10)
 else
  print("estrellas "..recogidas..
   "/"..#estrellas,4,117,7)
  print("z saltar",88,117,7)
 end
end

